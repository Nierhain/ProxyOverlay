<Project>
    <PropertyGroup>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <InformationalVersion>1.0.0</InformationalVersion>
        <Authors>Nierhain</Authors>
        <Company>Nierhain</Company>
        <Product>ProxyOverlay</Product>
        <Description>Batch image overlay tool for Magic proxies and other image-processing purposes.</Description>
        <PackageId Condition="'$(MSBuildProjectName)' == 'ProxyOverlay'">ProxyOverlay</PackageId>
        <RepositoryUrl>https://github.com/Nierhain/ProxyOverlay</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright © 2026 Nierhain</Copyright>
    </PropertyGroup>
</Project>
